# AISEO Scraping Service - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED - Service Authentication
# =============================================================================

# Shared secret for secure communication between Next.js and this service
# Generate with: openssl rand -base64 32
PROCESSING_SERVICE_API_KEY=

# =============================================================================
# AI API KEYS - Required for audit processing (Epic 4)
# =============================================================================

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Google Gemini API key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# Perplexity API key (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=

# DeepSeek API key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# xAI (Grok) API key (https://x.ai/)
XAI_API_KEY=
# =============================================================================
# LOCAL AI MODE (Ollama) — skip paid API keys for local development
# =============================================================================

# Set to true to route all engines through a local Ollama instance
# USE_LOCAL_AI=true

# Ollama model to use (default: qwen3:4b)
# OLLAMA_MODEL=qwen3:4b

# Ollama API base URL (default: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# MongoDB
# =============================================================================
MONGODB_URI=mongodb+srv://automateitcontact:q1ziUY6sTrKPUexf@automateit.ljmnevl.mongodb.net/ShowYourBrand