# AISEO Scraping Service - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED - Service Authentication
# =============================================================================

# Shared secret for secure communication between Next.js and this service
# Generate with: openssl rand -base64 32
PROCESSING_SERVICE_API_KEY=

# =============================================================================
# AI API KEYS - Required for audit processing (Epic 4)
# =============================================================================

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Google Gemini API key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# Perplexity API key (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=

# DeepSeek API key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# xAI (Grok) API key (https://x.ai/)
XAI_API_KEY=
MONGODB_URI=