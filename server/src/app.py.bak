from utils.dbal.ai_api_wrapper import call_openai_api, call_google_api, call_anthropic_api, call_perplexity_api, call_deepseek_api, call_xai_api
import os
import json
from dotenv import load_dotenv, dotenv_values 

load_dotenv()


def get_ais_score(business_data: dict) -> dict:
    """
    Get answers from AI engines for the given business data.
    """

    try:
        # Load specific questions for the given business type
        if business_data["business_type"] == "coffee_shop":
            specific_questions = json.load(open("utils/questions/fr/coffee_shop.json"))
        elif business_data["business_type"] == "restaurant":
            specific_questions = json.load(open("utils/questions/fr/restaurant.json"))
            
        # Load generic questions
        questions = json.load(open("utils/questions/fr/generic.json"))
    except Exception as e:
        print(f"Enable to load questions files (json). Error : {e}")
        return {
            "openai": None,
            "anthropic": None,
            "perplexity": None,
            "deepseek": None,
            "xai": None,
            "success": False,
            "global" : None
        }

    ai_answers = {
        "gemini" : {},
        "openai" : {},
        "anthropic" : {},
        "perplexity" : {},
        "deepseek" : {},
        "grok" : {}
     }

    for ai_call, ai_name in zip([call_google_api, call_openai_api, call_anthropic_api, call_perplexity_api, call_deepseek_api, call_xai_api], ai_answers.keys()):
        for question in questions["questions_generiques"]:
            question_text = question["question"].format(business_data)
            question_id = question["id"]

            ai_answer = ai_call(
                api_key=os.getenv(f"{ai_name.upper()}_API_KEY"),
                message=question_text,
            )

            

            if ai_answer["success"]:
                if business_data["name"] in ai_answer["response"]:
                    ai_answer["finded"] == True
                ai_answers[ai_name][question_id] = ai_answer
            else:
                ai_answers[ai_name][question_id] = None

            




if __name__ == "__main__":

    # Check for env variables
    if not os.getenv("OPENAI_API_KEY") or not os.getenv("ANTHROPIC_API_KEY") or not os.getenv("PERPLEXITY_API_KEY") or not os.getenv("DEEPSEEK_API_KEY") or not os.getenv("GROK_API_KEY"):
        raise ValueError("Missing API keys")

    # Get business data
    business_data = {
        "name": "Acme Corp",
        "description": "A company that makes widgets",
        "location": "New York, NY",
        "business_type" : "coffee_shop"
    }

    get_ais_score(business_data)

