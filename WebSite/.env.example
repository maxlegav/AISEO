# ============================================================
# ShowYourBrand — Environment Variables Template
# Copy to .env.local and fill in your values
# ============================================================

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/showyourbrand
MONGODB_ENCRYPTION_KEY=                  # 32-byte base64 key (field encryption)

# --- NextAuth ---
# NEXTAUTH_URL MUST be the public app URL in prod (used for Stripe success/cancel
# redirects). If wrong/unset in prod, checkout redirects break.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                        # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe --- (see STRIPE_SETUP.md)
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Price IDs — create the 5 prices in the Stripe Dashboard and paste their price_… IDs.
# These are the SINGLE SOURCE mapped to tiers in config.ts / the webhook.
NEXT_PUBLIC_STRIPE_PRICE_ID_DATA=price_          # Data      — €29 one-shot
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_       # Starter   — €79 one-shot
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_           # Pro       — €59/mo subscription
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY=price_        # Agency    — €599/mo subscription
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY_EXTRA=price_  # Extra Audit — €50 one-shot (agency)

# --- Email (Resend) ---
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@showyourbrand.app
ADMIN_EMAIL=                            # receives admin notifications

# --- AI APIs (SYB v2 monitoring pipeline — called directly from Next.js) ---
# When a key is missing, that engine falls back to the deterministic mock so the
# dashboard/pipeline still work end-to-end without real keys (dev / validation).
OPENAI_API_KEY=sk-proj-
ANTHROPIC_API_KEY=sk-ant-
PERPLEXITY_API_KEY=pplx-
GEMINI_API_KEY=
# Optional model overrides (defaults are the cheap small models from the PRD)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
PERPLEXITY_MODEL=sonar
GEMINI_MODEL=gemini-1.5-flash

# --- Processing Service (Python FastAPI — see ../server/TAKEOVER.md) ---
PROCESSING_SERVICE_URL=http://localhost:8080   # prod: http://83.228.202.11
PROCESSING_SERVICE_API_KEY=             # shared secret; MUST match server/.env

# --- Cron Jobs ---
CRON_SECRET=                            # openssl rand -base64 32

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
