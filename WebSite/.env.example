# ============================================================
# ShowYourBrand — Environment Variables Template
# Copy to .env.local and fill in your values
# ============================================================

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/showyourbrand

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                        # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Price IDs (create in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRICE_ID_DATA=price_      # €29 one-shot
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_   # €79 one-shot
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_       # €59/mo subscription
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY=price_    # €599/mo subscription

# --- Email (Resend) ---
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@showyourbrand.app
ADMIN_EMAIL=                            # receives admin notifications

# --- AI APIs (used by Python processing service) ---
OPENAI_API_KEY=sk-proj-
ANTHROPIC_API_KEY=sk-ant-
PERPLEXITY_API_KEY=pplx-
GEMINI_API_KEY=

# --- Processing Service ---
PROCESSING_SERVICE_URL=http://localhost:5000
PROCESSING_SERVICE_API_KEY=             # shared secret between Next.js and Python server

# --- Cron Jobs ---
CRON_SECRET=                            # openssl rand -base64 32

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
