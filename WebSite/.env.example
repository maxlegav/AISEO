# ShowYourBrand Platform - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# DATABASE
# ============================================

# MongoDB Connection URI
# For local: mongodb://localhost:27017/ShowYourBrand
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/ShowYourBrand
MONGODB_URI=mongodb+srv://your-connection-string

# MongoDB Encryption Key (AES-256, 32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
MONGODB_ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# ============================================
# NEXT_AUTH (Authentication)
# ============================================

# NextAuth URL (your application URL)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (random string for JWT encryption)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key

# Google OAuth Credentials (optional - for Google Sign-In)
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# STRIPE (Payments & Subscriptions)
# ============================================

# Stripe Secret Key (for backend)
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe Public Key (for frontend)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# Stripe Price IDs (from Stripe Dashboard > Products)
STRIPE_PRICE_ID_BASIC=price_basic_monthly_id
STRIPE_PRICE_ID_PRO=price_pro_monthly_id
STRIPE_PRICE_ID_PREMIUM=price_premium_monthly_id
STRIPE_PRICE_ID_ONE_SHOT=price_one_shot_id

# Stripe Webhook Secret (for webhook signature verification)
# Get from: Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# EMAIL (Resend)
# ============================================

# Resend API Key
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Email "From" Address
# Must be verified domain in Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# AI APIS (For Audit Engine)
# ============================================

# OpenAI API Key (for ChatGPT prompt testing)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Anthropic API Key (for Claude prompt testing)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Perplexity API Key (for Perplexity prompt testing)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key

# DeepSeek API Key (for DeepSeek prompt testing)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ============================================
# PROCESSING SERVICE (Docker Service)
# ============================================

# Processing Service API Key (shared secret for authentication)
# Generate with: openssl rand -base64 32
PROCESSING_SERVICE_API_KEY=your-processing-service-api-key

# Processing Service URL
# Development: http://localhost:5000
# Production: https://your-processing-service-url
PROCESSING_SERVICE_URL=http://localhost:5000

# ============================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================

# Sentry DSN (for error tracking - optional)
# Get from: https://sentry.io/
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Plausible Domain (for privacy-friendly analytics - optional)
# Set in next-sitemap.config.js if using
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# ============================================
# OPTIONAL: REDIS (For Rate Limiting - Production)
# ============================================

# Upstash Redis URL (for production rate limiting)
# Get from: https://upstash.com/
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Node Environment (automatically set by Vercel in production)
# NODE_ENV=development
