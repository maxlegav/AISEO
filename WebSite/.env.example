# ============================================================
# ShowYourBrand — Environment Variables Template
# Copy to .env.local and fill in your values
# ============================================================

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/showyourbrand
MONGODB_ENCRYPTION_KEY=                  # 32-byte base64 key (field encryption)

# --- NextAuth ---
# NEXTAUTH_URL MUST be the public app URL in prod (used for Stripe success/cancel
# redirects). If wrong/unset in prod, checkout redirects break.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                        # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe --- (see STRIPE_SETUP.md)
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Price IDs — create the 5 prices in the Stripe Dashboard and paste their price_… IDs.
# These are the SINGLE SOURCE mapped to tiers in config.ts / the webhook.
NEXT_PUBLIC_STRIPE_PRICE_ID_DATA=price_          # Data      — €29 one-shot
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=price_       # Starter   — €79 one-shot
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_           # Pro       — €59/mo subscription
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY=price_        # Agency    — €599/mo subscription
NEXT_PUBLIC_STRIPE_PRICE_ID_AGENCY_EXTRA=price_  # Extra Audit — €50 one-shot (agency)

# SYB v2 — recurring GEO *monitoring* plans (Solo / Pro / Agence). Create these
# as monthly recurring prices in Stripe. Limits live in lib/monitoring/plans.ts.
NEXT_PUBLIC_STRIPE_PRICE_ID_MONITORING_SOLO=price_    # Solo   — €29/mo   (2 projets, 3 moteurs, hebdo)
NEXT_PUBLIC_STRIPE_PRICE_ID_MONITORING_PRO=price_     # Pro    — €79/mo   (10 projets, 4 moteurs, quotidien)
NEXT_PUBLIC_STRIPE_PRICE_ID_MONITORING_AGENCY=price_  # Agence — €149/mo  (illimité, quotidien, PDF marque blanche)

# --- LLM spend guard ---
# Monthly LLM budget per plan, in euros. A configuration whose monthly
# projection exceeds the budget is refused at creation; runs stop once the
# month's budget is actually spent. Defaults keep the bill under a third of the
# plan price and fund 150 questions per project on Solo.
MONITORING_BUDGET_SOLO_EUR=8.5
MONITORING_BUDGET_PRO_EUR=22
MONITORING_BUDGET_AGENCY_EUR=45

# Cost of one call per engine, in micro-euros (1e-6 EUR). Derived from the
# vendors' published prices for 165 input / 300 output tokens — Perplexity is
# the expensive one because of its flat $5/1000-request fee. Re-derive when
# real invoices disagree.
# MONITORING_COST_CHATGPT_UEUR=190
# MONITORING_COST_GEMINI_UEUR=741
# MONITORING_COST_CLAUDE_UEUR=1542
# MONITORING_COST_PERPLEXITY_UEUR=5060

# --- Email (Resend) ---
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@showyourbrand.app
ADMIN_EMAIL=                            # receives admin notifications

# --- AI APIs (SYB v2 monitoring pipeline — called directly from Next.js) ---
# When a key is missing, that engine falls back to the deterministic mock so the
# dashboard/pipeline still work end-to-end without real keys (dev / validation).
OPENAI_API_KEY=sk-proj-
ANTHROPIC_API_KEY=sk-ant-
PERPLEXITY_API_KEY=pplx-
GEMINI_API_KEY=
# Optional model overrides (defaults are the cheap small models from the PRD)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
PERPLEXITY_MODEL=sonar

GEMINI_MODEL=gemini-2.5-flash

# --- Cron Jobs ---
CRON_SECRET=                            # openssl rand -base64 32

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
