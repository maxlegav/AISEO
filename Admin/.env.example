# MongoDB (same database as WebSite)
MONGODB_URI=mongodb+srv://...

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# Google OAuth (can reuse same Google app, or create a separate one for admin)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Restrict admin access to this single Google email
ADMIN_EMAIL=your-admin-email@gmail.com

# Processing Service (same as WebSite)
PROCESSING_SERVICE_URL=http://localhost:5000
PROCESSING_SERVICE_API_KEY=<shared-bearer-token>
